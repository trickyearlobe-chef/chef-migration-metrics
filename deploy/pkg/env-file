# =============================================================================
# Chef Migration Metrics — Environment File
# =============================================================================
# Sourced by the systemd unit via EnvironmentFile=. It carries the application's
# secrets and nothing else — every other setting is configured in the admin UI
# and stored, encrypted, in the database.
#
# Location:
#   RPM:  /etc/sysconfig/chef-migration-metrics
#   DEB:  /etc/default/chef-migration-metrics
#
# Keep this file mode 0640, owned root:root: systemd reads it as root at start-up
# and passes the values to the service as environment variables.
# =============================================================================

# REQUIRED. Base64 master key that encrypts stored credentials in the database.
# Generate once with:  openssl rand -base64 32
# The application will not start without it, and losing it means re-entering
# every stored credential.
#CMM_CREDENTIAL_ENCRYPTION_KEY=

# Password for the seeded "admin" account on first start. If unset, a built-in
# default is used — always set this before the first start.
#CMM_DEFAULT_ADMIN_PASSWORD=

# OPTIONAL. Database connection string. The connection is normally set in
# config.yml (datastore.url); use this only to supply or override it from the
# environment instead.
#DATABASE_URL=postgres:///chef_migration_metrics?host=/var/run/postgresql&sslmode=disable
