# =============================================================================
# Chef Migration Metrics — Bootstrap Configuration
# =============================================================================
# This file's ONLY job is to tell the application how to reach its PostgreSQL
# database at start-up.
#
# Everything else — Chef organisations and credentials, target Chef versions,
# TLS, the collection schedule, logging, and so on — is configured in the web UI
# (Admin -> Settings) and stored, encrypted, in the database. You do not edit
# YAML to configure the application.
# =============================================================================

# ---------------------------------------------------------------------------
# Database connection (required)
# ---------------------------------------------------------------------------
# Local PostgreSQL over a Unix socket with peer authentication (no password):
# run the service as the "chef-migration-metrics" OS user, create a database
# role of the same name that owns the database, and use a socket DSN.
database_url: "postgres:///chef_migration_metrics?host=/var/run/postgresql&sslmode=disable"
# Remote or managed PostgreSQL uses a standard URL with credentials and TLS
# (replace USER / PASS with the real values):
#   database_url: "postgres://USER:PASS@db.example.com:5432/chef_migration_metrics?sslmode=require"

# ---------------------------------------------------------------------------
# Server bind address (optional — bind-failure fallback only)
# ---------------------------------------------------------------------------
# The listen address and port are managed in the UI (Admin -> Server & TLS) and
# stored in the database. The values below are consulted only if the
# database-stored address/port cannot be bound at start-up, so the UI can never
# lock itself out. Defaults to 0.0.0.0:8080 if omitted.
# listen_address: "0.0.0.0"
# listen_port: 8080
