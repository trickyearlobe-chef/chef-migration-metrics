# =============================================================================
# Local Development Runtime Data
# =============================================================================
.local/
.samples/
deploy/pkg/config.yml
deploy/pkg/config.yml.migrated

# =============================================================================
# Build Output
# =============================================================================

# Go binary and cross-compiled artifacts
build/
/chef-migration-metrics
cmd/chef-migration-metrics/chef-migration-metrics
*.exe
*.exe~
*.dll
*.so
*.dylib

# nFPM package output
*.rpm
*.deb

# =============================================================================
# Embedded Ruby Environment (built by make build-embedded)
# =============================================================================
# The entire embedded/ tree is a build artifact, covered by build/ above.
# If built outside build/ for any reason:
# NOTE: Use leading / so this only matches the top-level embedded/ directory
# and does NOT match internal/embedded/ (which contains Go source files).
/embedded/

# =============================================================================
# Go
# =============================================================================
# Module vendor directory (if vendoring is used)
vendor/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Go workspace file
go.work
go.work.sum

# =============================================================================
# Frontend (React / Node.js)
# =============================================================================
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.cache/
frontend/.parcel-cache/
frontend/.next/
frontend/.nuxt/

# TypeScript declaration output (emitDeclarationOnly for project references)
frontend/*.d.ts
frontend/tsconfig.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo
frontend/vite.config.d.ts

# npm / yarn / pnpm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json.bak

# =============================================================================
# IDE and Editor
# =============================================================================

# Visual Studio Code — ignore everything except shared workspace settings
# (Copilot/search exclusions, tracked for the whole team).
.vscode/*
!.vscode/settings.json
*.code-workspace

# JetBrains (GoLand, IntelliJ, WebStorm)
.idea/
*.iml
*.ipr
*.iws
out/

# Vim / Neovim
*.swp
*.swo
*~
tags

# Emacs
\#*\#
.#*
*.elc

# Sublime Text
*.sublime-project
*.sublime-workspace

# Zed — ignore everything except shared workspace settings
.zed/*
!.zed/settings.json

# Claude Code — ignore the entire local Claude Code working directory
.claude/

# =============================================================================
# Operating System
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Secrets and Credentials (NEVER commit these)
# =============================================================================

# Chef API private keys
*.pem
keys/
deploy/docker-compose/keys/

# Pre-commit hook deny patterns (contains real customer names)
.git-deny-patterns

# Environment files with real credentials
.env
deploy/docker-compose/.env

# TLS certificates and private keys
*.key
*.crt
*.cert
*.p12
*.pfx

# ACME certificate storage (account keys, issued certs, metadata).
# Root-anchored: ACME state is DB-backed (ACME state is stored in the database), so this only
# guards a stray runtime dir and must NOT match the internal/acme/ source pkg.
/acme/

# =============================================================================
# Runtime and Application Data
# =============================================================================

# PostgreSQL data (Docker Compose local volumes)
pgdata/

# Git clones and cookbook working directories
cookbook_data/

# Export output files
exports/
*.ndjson

# ACME runtime data (if stored outside the acme/ pattern above)
.lego/
.certmagic/

# =============================================================================
# Docker
# =============================================================================
# Docker Compose override files (local customisations)
docker-compose.override.yml
docker-compose.override.yaml

# =============================================================================
# Test and CI Artifacts
# =============================================================================

# Test Kitchen
.kitchen/
.kitchen.local.yml

# CookStyle / RuboCop cache
.rubocop-cache/

# Go lint cache (local)
.golangci-lint/

# CI artifacts
junit.xml
test-results/

# json-event-catcher MCP local DB (dev-only, transient)
events.db
events.db-shm
events.db-wal

# API probe output. Shapes only, no values — but an object's keys can be data,
# and it is a generated capture from whatever instance you pointed at, not
# source. Globbed rather than named: the tool takes an output path, and a
# capture written to the repository root is one `git add .` from being
# committed.
tools/api-probe/*.json
probe*.json
