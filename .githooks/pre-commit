#!/usr/bin/env bash
# =============================================================================
# Pre-commit hook — Prevent accidental commit of secrets and credentials
# =============================================================================
# Install: make install-hooks
# Skip:    git commit --no-verify (use only when you are certain)
# =============================================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
RESET='\033[0m'

BLOCKED=0
WARNINGS=0

# ---------------------------------------------------------------------------
# Helper: report a blocked file
# ---------------------------------------------------------------------------
block() {
  local file="$1" reason="$2"
  printf "${RED}BLOCKED${RESET}  %s — %s\n" "$file" "$reason" >&2
  BLOCKED=$((BLOCKED + 1))
}

warn() {
  local file="$1" reason="$2"
  printf "${YELLOW}WARNING${RESET}  %s — %s\n" "$file" "$reason" >&2
  WARNINGS=$((WARNINGS + 1))
}

# ---------------------------------------------------------------------------
# Collect list of staged files (added, copied, modified, renamed)
# ---------------------------------------------------------------------------
STAGED_FILES=()
while IFS= read -r f; do
  [[ -n "$f" ]] && STAGED_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)

if [[ ${#STAGED_FILES[@]} -eq 0 ]]; then
  exit 0
fi

# ---------------------------------------------------------------------------
# 1. Filename / extension checks — catch secrets by file type
# ---------------------------------------------------------------------------
# Patterns aligned with .gitignore "Secrets and Credentials" section.
for file in "${STAGED_FILES[@]}"; do
  # Extension checks
  case "$file" in
    *.pem)  block "$file" "file extension .pem matches a known secret type" ;;
    *.key)  block "$file" "file extension .key matches a known secret type" ;;
    *.p12)  block "$file" "file extension .p12 matches a known secret type" ;;
    *.pfx)  block "$file" "file extension .pfx matches a known secret type" ;;
  esac

  # .env files (but not .env.example)
  base=$(basename "$file")
  if [[ "$base" == ".env" ]]; then
    block "$file" ".env file likely contains credentials"
  fi

  # keys/ directory
  if [[ "$file" == keys/* || "$file" == */keys/* ]]; then
    block "$file" "file path matches a known secrets directory (keys/)"
  fi

  # acme/ runtime storage dir (root-anchored). ACME state is DB-backed
  # (ACME state is stored in the database), so only a stray root-level acme/ dir would hold key
  # material; the internal/acme/ source package must NOT be blocked.
  if [[ "$file" == acme/* ]]; then
    block "$file" "file path matches a known secrets directory (acme/)"
  fi
done

# ---------------------------------------------------------------------------
# 1b. Deny-patterns check — block customer names and other sensitive strings
# ---------------------------------------------------------------------------
# Reads regexes from .git-deny-patterns (one per line, # = comment).
# The file is gitignored so real customer names never enter the repo.
DENY_FILE=".git-deny-patterns"
if [[ -f "$DENY_FILE" ]]; then
  DENY_PATTERNS=""
  while IFS= read -r line; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    if [[ -z "$DENY_PATTERNS" ]]; then
      DENY_PATTERNS="$line"
    else
      DENY_PATTERNS="$DENY_PATTERNS|$line"
    fi
  done < "$DENY_FILE"

  if [[ -n "$DENY_PATTERNS" ]]; then
    # Scan the staged diff (added lines only) for denied patterns.
    # Excludes the example file and the deny-patterns file itself.
    DENY_MATCHES=$(git diff --cached --diff-filter=ACMR -U0 -- . \
      ':(exclude).git-deny-patterns' \
      ':(exclude).git-deny-patterns.example' \
      | grep -iE -- "$DENY_PATTERNS" || true)
    if [[ -n "$DENY_MATCHES" ]]; then
      printf "${RED}BLOCKED${RESET}  Staged changes contain denied patterns (see %s):\n" "$DENY_FILE" >&2
      printf '%s\n' "$DENY_MATCHES" >&2
      BLOCKED=$((BLOCKED + 1))
    fi
  fi
fi

# ---------------------------------------------------------------------------
# 2. Content checks — scan staged file contents for secret patterns
# ---------------------------------------------------------------------------
# We scan the staged (cached) version of each file, not the working copy,
# so the check is accurate even if the working tree has diverged.
#
# All patterns use grep -E (POSIX extended regex) with -- to prevent
# leading hyphens from being interpreted as options. Case-insensitive
# patterns use grep -iE.

# File types to skip for content scanning (binary, images, fonts, etc.)
skip_content_scan() {
  case "$1" in
    *.png|*.jpg|*.jpeg|*.gif|*.ico|*.webp) return 0 ;;
    *.woff|*.woff2|*.ttf|*.eot) return 0 ;;
    *.svg) return 0 ;;
    *.mp3|*.mp4|*.wav|*.ogg) return 0 ;;
    *.zip|*.tar|*.gz|*.bz2|*.xz|*.7z) return 0 ;;
    *.pdf|*.doc|*.docx) return 0 ;;
    *.exe|*.dll|*.so|*.dylib) return 0 ;;
    *) return 1 ;;
  esac
}

# Files that contain secret patterns as documentation or regex definitions,
# not actual secrets. Skip these from content scanning.
skip_content_allowlist() {
  local f="$1"
  case "$f" in
    .githooks/pre-commit) return 0 ;;
    cmd/chef-migration-metrics/main.go) return 0 ;; # default seed password constant, not a real secret
    frontend/src/pages/credentials/ValueField.tsx) return 0 ;; # PEM-header placeholder in input hint, not a real key
    deploy/docker-compose/.env.example) return 0 ;;
    deploy/docker-compose/README.md) return 0 ;;
    deploy/pkg/env-file) return 0 ;; # packaged env template — placeholder DATABASE_URL, not a real secret
    deploy/elk/.env.example) return 0 ;;
    deploy/elk/README.md) return 0 ;;
    README.md) return 0 ;;
    *_test.go) return 0 ;;
  esac
  # Subdirectory patterns (case globs don't reliably handle deep nesting)
  [[ "$f" == .github/workflows/*.yml ]] && return 0
  return 1
}

# Each check function receives the filename as $1 and staged content as $2.
# Using separate functions keeps the patterns readable and avoids shell
# quoting issues with arrays of complex regexes.

check_private_key() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qE -- '-----BEGIN (RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----'; then
    block "$file" "PEM-encoded private key"
  fi
}

check_certificate() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qE -- '-----BEGIN CERTIFICATE-----'; then
    warn "$file" "PEM-encoded certificate (verify this is intentional)"
  fi
}

check_aws_access_key() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qE -- 'AKIA[0-9A-Z]{16}'; then
    block "$file" "AWS Access Key ID"
  fi
}

check_aws_secret_key() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qiE -- '(aws_secret_access_key|aws_secret_key)[[:space:]]*[=:][[:space:]]*[^[:space:]]+'; then
    block "$file" "AWS secret access key assignment"
  fi
}

check_github_tokens() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qE -- 'ghp_[0-9a-zA-Z]{36}'; then
    block "$file" "GitHub personal access token"
  fi
  if printf '%s\n' "$content" | grep -qE -- 'gho_[0-9a-zA-Z]{36}'; then
    block "$file" "GitHub OAuth token"
  fi
  if printf '%s\n' "$content" | grep -qE -- 'ghs_[0-9a-zA-Z]{36}'; then
    block "$file" "GitHub server-to-server token"
  fi
  if printf '%s\n' "$content" | grep -qE -- 'ghu_[0-9a-zA-Z]{36}'; then
    block "$file" "GitHub user-to-server token"
  fi
  if printf '%s\n' "$content" | grep -qE -- 'github_pat_[0-9a-zA-Z_]{22,}'; then
    block "$file" "GitHub fine-grained PAT"
  fi
}

check_openai_stripe() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qE -- 'sk-[0-9a-zA-Z]{20,}'; then
    block "$file" "OpenAI or Stripe secret key"
  fi
}

check_sendgrid() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qE -- 'SG\.[0-9A-Za-z_-]{22}\.[0-9A-Za-z_-]{43}'; then
    block "$file" "SendGrid API key"
  fi
}

check_slack() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qE -- 'xox[bpras]-[0-9a-zA-Z-]{10,}'; then
    block "$file" "Slack token"
  fi
}

check_cmm_master_key() {
  local file="$1" content="$2"
  if printf '%s\n' "$content" | grep -qE -- 'CMM_CREDENTIAL_ENCRYPTION_KEY[[:space:]]*=[[:space:]]*[^[:space:]]{8,}'; then
    block "$file" "Master encryption key value"
  fi
}

check_generic_password() {
  local file="$1" content="$2"
  # Match assignments like: password = "realvalue", secret: 'topsecret', api_key="abcdefgh"
  # Require the value to be at least 8 characters to reduce false positives.
  if printf '%s\n' "$content" | grep -qiE -- "(password|passwd|secret|api_key|apikey|api_secret)[[:space:]]*[=:][[:space:]]*[\"'][^\"'[:space:]]{8,}"; then
    block "$file" "Possible hardcoded credential"
  fi
}

check_database_url() {
  local file="$1" content="$2"
  # postgres://user:password@host, mysql://..., mongodb://..., redis://...
  if printf '%s\n' "$content" | grep -qiE -- '(postgres|mysql|mongodb|redis)://[^:]+:[^@[:space:]]{8,}@'; then
    block "$file" "Database connection string with embedded password"
  fi
}

for file in "${STAGED_FILES[@]}"; do
  # Skip binary-like files
  if skip_content_scan "$file"; then
    continue
  fi

  # Skip files in the allowlist (contain patterns as documentation, not real secrets)
  if skip_content_allowlist "$file"; then
    continue
  fi

  # Get the staged content of the file
  staged_content=$(git show ":$file" 2>/dev/null) || continue

  # Skip empty files
  [[ -z "$staged_content" ]] && continue

  check_private_key "$file" "$staged_content"
  check_certificate "$file" "$staged_content"
  check_aws_access_key "$file" "$staged_content"
  check_aws_secret_key "$file" "$staged_content"
  check_github_tokens "$file" "$staged_content"
  check_openai_stripe "$file" "$staged_content"
  check_sendgrid "$file" "$staged_content"
  check_slack "$file" "$staged_content"
  check_cmm_master_key "$file" "$staged_content"
  check_generic_password "$file" "$staged_content"
  check_database_url "$file" "$staged_content"
done

# ---------------------------------------------------------------------------
# 3. Large file check — secrets sometimes hide in large unexpected files
# ---------------------------------------------------------------------------
SIZE_LIMIT_KB=500

for file in "${STAGED_FILES[@]}"; do
  case "$file" in
    *.go|*.js|*.ts|*.tsx|*.jsx|*.json|*.yaml|*.yml|*.md|*.sql|*.sh|*.css|*.html)
      size_bytes=$(git cat-file -s ":$file" 2>/dev/null) || continue
      size_kb=$((size_bytes / 1024))
      if [[ $size_kb -gt $SIZE_LIMIT_KB ]]; then
        warn "$file" "unusually large source file (${size_kb} KB) — verify no embedded secrets"
      fi
      ;;
  esac
done
# ---------------------------------------------------------------------------
# 4. Journeys, not specifications
# ---------------------------------------------------------------------------
# A journey answers four questions in the words the person would use: who they
# are and what they are trying to get done, what must be true for them to
# succeed, what they see or do, and how they would know it worked.
#
# Everything else is owned by the code. A contract belongs in a test that fails
# when it stops being true; a table, column, endpoint or symbol belongs in the
# code that defines it. A technical claim written in prose is a copy that
# nothing re-validates — it rots, and is then believed.
#
# A journey MAY point at the code or test that owns a contract, but only as a
# markdown link, because a link can be checked:
#
#     the verdict is pinned by [the derivation contract](internal/analysis/semantic_contracts_test.go#TestContract_CookstyleStatus_StaleIsUnknown)
#
# The target must exist, and the optional #fragment must appear in it. A
# reference that goes stale therefore fails the commit that made it stale,
# which is the whole point: it gets fixed by the work that broke it rather than
# by an audit nobody runs. Bare paths and symbols in prose stay blocked — they
# are unresolvable, so nothing can tell you when they stop being true.
#
# This is enforced rather than advised because advising it did not work: the
# warning sat at the top of the journey index and twice in CLAUDE.md, and the
# the specs drifted anyway. The retired corpus is in the tag
# specifications-retired-2026-08-04 if the history is ever needed.
JOURNEY_LINE_LIMIT=200

# Report the first few offending lines for a pattern, and block the commit.
journey_block() {
  local file="$1" pattern="$2" reason="$3" content="$4" hits
  hits=$(printf '%s\n' "$content" | grep -nE "$pattern" | head -3) || true
  if [[ -n "$hits" ]]; then
    block "$file" "$reason"
    printf '%s\n' "$hits" | sed 's/^/    line /' >&2
  fi
}

journey_warn() {
  local file="$1" pattern="$2" reason="$3" content="$4" hits
  hits=$(printf '%s\n' "$content" | grep -nE "$pattern" | head -3) || true
  if [[ -n "$hits" ]]; then
    warn "$file" "$reason"
    printf '%s\n' "$hits" | sed 's/^/    line /' >&2
  fi
}

for file in "${STAGED_FILES[@]}"; do
  case "$file" in
    journeys/README.md) continue ;;   # states the rule; exempt from it
    journeys/*.md) ;;
    *) continue ;;
  esac

  journey_content=$(git show ":$file" 2>/dev/null) || continue
  [[ -z "$journey_content" ]] && continue

  lines=$(printf '%s\n' "$journey_content" | wc -l | tr -d ' ')
  if [[ $lines -gt $JOURNEY_LINE_LIMIT ]]; then
    block "$file" "journey is ${lines} lines (limit ${JOURNEY_LINE_LIMIT}) — a journey is short; if it needs more, the detail belongs in tests or is a second journey"
  fi

  # ---- the journey must name a test ---------------------------------------
  # Agreed 2026-08-05. Nothing here says built, shipped or proven, because a
  # status line is the first thing to rot — the stalest line in the best
  # document we had was its status line. So the journey names the test that
  # proves it instead, and a red test says "not proven" without anybody
  # maintaining a sentence that says so.
  #
  # One resolving link satisfies the rule. It deliberately does not ask for
  # coverage: roughly a third of what a journey promises cannot carry an
  # assertion at all ("the list is short enough to work through"), and a rule
  # demanding a test per claim would be met with tests that assert nothing,
  # which is worse than no test because it looks proven. The journey says in
  # prose which parts nothing can prove; no check can tell an honest admission
  # from a silent omission, so that part is not enforced.
  journey_tests=$(printf '%s\n' "$journey_content" | grep -oE '\]\([^)]+\)' \
    | grep -cE '_test\.go|\.test\.(ts|tsx)|/test-[A-Za-z0-9_-]+\.sh') || true
  if [[ "$journey_tests" -eq 0 ]]; then
    block "$file" "journey names no test — link one test that proves part of it, and say in prose which parts nothing can prove; a red test is the point, it means 'not proven yet'"
  fi

  # ---- checked references -------------------------------------------------
  # Resolve every markdown link that points into the repo. Line numbers are
  # preserved for the prose checks below because only the link text is blanked.
  while IFS= read -r target; do
    [[ -z "$target" ]] && continue
    case "$target" in
      http://*|https://*|mailto:*|'#'*) continue ;;
      archive/*)
        block "$file" "journey links into archive/ — that material is historical and not authoritative; link the code or test that owns this instead"
        continue ;;
    esac
    ref_path="${target%%#*}"
    ref_sym="${target#*#}"
    [[ "$ref_sym" == "$target" ]] && ref_sym=""
    # A link to a sibling journey is relative to this file's directory; a link
    # to code is written from the repo root. Accept either, block only if
    # neither resolves.
    if [[ -e "$(dirname "$file")/$ref_path" ]]; then
      ref_path="$(dirname "$file")/$ref_path"
    elif [[ ! -e "$ref_path" ]]; then
      block "$file" "journey references '${ref_path}', which does not exist — fix the reference in the change that moved it"
      continue
    fi
    if [[ -n "$ref_sym" ]] && ! grep -qF -- "$ref_sym" "$ref_path" 2>/dev/null; then
      block "$file" "journey references '${ref_sym}' in ${ref_path}, which no longer contains it — fix the reference in the change that renamed it"
    fi
  done < <(printf '%s\n' "$journey_content" | grep -oE '\]\([^)]+\)' | sed -E 's/^\]\(//; s/\)$//')

  # ---- prose checks -------------------------------------------------------
  # Link constructs are removed first: a checked reference is allowed to name a
  # path or a symbol, unchecked prose is not.
  #
  # This reads the whole file as one record rather than line by line, because
  # prose is wrapped at around 100 columns and a link with a long target
  # routinely breaks between its text and its target. Line-by-line removal
  # leaves the orphaned target behind, and it is then indistinguishable from a
  # bare path — so writing a correctly linked reference and wrapping it would
  # block the commit.
  #
  # Each removed link leaves behind exactly the newlines it contained, so the
  # line numbers reported below still match the file the author is looking at.
  journey_prose=$(printf '%s\n' "$journey_content" | awk '
    BEGIN { RS = "\1" }                 # no \1 in text, so the record is the file
    {
      s = $0; out = ""
      while (match(s, /\[[^]]*\]\([^)]*\)/)) {
        link = substr(s, RSTART, RLENGTH)
        n = gsub(/\n/, "\n", link)      # returns the newline count, link unchanged
        pad = ""
        for (i = 0; i < n; i++) pad = pad "\n"
        out = out substr(s, 1, RSTART - 1) pad
        s = substr(s, RSTART + RLENGTH)
      }
      printf "%s%s", out, s
    }')

  journey_block "$file" '^```' \
    "code fence in a journey — a contract belongs in a test, and code is the source of truth for everything else" \
    "$journey_prose"

  journey_block "$file" '(^|[^A-Za-z0-9_/.])(internal|cmd|frontend|migrations|scripts)/|[A-Za-z0-9_-]+\.(go|ts|tsx|jsx|sql|rb)([^A-Za-z0-9]|$)' \
    "unchecked source path in a journey — make it a markdown link so a rename fails the commit, or describe what the person does instead" \
    "$journey_prose"

  journey_block "$file" '(SELECT[[:space:]]+.*[[:space:]]FROM|CREATE[[:space:]]+TABLE|ALTER[[:space:]]+TABLE|INSERT[[:space:]]+INTO|(LEFT|INNER|OUTER)[[:space:]]+JOIN)' \
    "SQL in a journey — the schema is owned by the migrations and the code" \
    "$journey_prose"

  journey_block "$file" '(GET|POST|PUT|PATCH|DELETE)[[:space:]]+/[a-z]' \
    "HTTP endpoint in a journey — the API is owned by the handlers" \
    "$journey_prose"

  journey_block "$file" '[A-Za-z_][A-Za-z0-9_]*\.[A-Za-z_][A-Za-z0-9_]*\(|[a-zA-Z_][a-zA-Z0-9_]*\(\)' \
    "unchecked function reference in a journey — link the test that pins it, or write it as a test that fails when it stops being true" \
    "$journey_prose"

  journey_block "$file" '`[A-Za-z0-9]+(_[A-Za-z0-9]+)+`|`[a-z0-9]+(\.[a-z0-9_]+)+`' \
    "code identifier in a journey (table, column or config key) — say what the person sees, not what it is called in code" \
    "$journey_prose"

  journey_warn "$file" '`[A-Za-z0-9]*[a-z0-9]([A-Z][A-Za-z0-9]*)+`' \
    "backticked CamelCase — fine if it is a product name the person would say, a symbol if it is not" \
    "$journey_prose"
done

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
if [[ $BLOCKED -gt 0 ]]; then
  echo "" >&2
  printf "${RED}✗ Commit blocked: %d issue(s) found in staged files.${RESET}\n" "$BLOCKED" >&2
  echo "  Review the files above (secrets, denied patterns, or oversized journeys) before committing." >&2
  echo "  If you are certain these are safe, use: git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

if [[ $WARNINGS -gt 0 ]]; then
  echo "" >&2
  printf "${YELLOW}⚠ %d warning(s) — review before pushing.${RESET}\n" "$WARNINGS" >&2
  echo "" >&2
fi

exit 0
