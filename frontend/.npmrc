# npm supply-chain hardening for the frontend workspace.
#
# Block install lifecycle scripts (preinstall / install / postinstall). These
# run automatically on `npm install` / `npm ci` and are the primary remote-code-
# execution vector for a compromised or trojanised dependency. This dependency
# set declares no real install scripts — the native packages here ship prebuilt
# platform binaries selected by os/cpu, not built on install — so blocking is
# safe. If a future dependency genuinely needs a native build, run it explicitly
# and audited via `npm rebuild <pkg>`.
ignore-scripts=true

# Reproducible, lockfile-faithful installs: pin exact versions on save.
save-exact=true

# Fail `npm audit` at high severity or above. Takes effect once the registry
# advisory endpoint is reachable; harmless otherwise.
audit-level=high

# Reduce noise.
fund=false

# Install through the org's Harness Artifact Registry (a public npm proxy; the
# org id in the URL path is an identifier, not a secret). Committing it here
# makes installs use the proxy by default, with no per-machine ~/.npmrc setup.
registry=https://pkg.harness.io/pkg/ct8onj8YTdaXtKaFsYCRLg/org-chef-npm/npm/

# Registry-agnostic lockfile: the `integrity` hash pins each package's content,
# so omitting the resolved registry URL keeps package-lock.json reproducible
# without baking the org-specific proxy URL into every entry (and it resolves
# fine against a public mirror too).
omit-lockfile-registry-resolved=true

# NEVER place an _authToken or any credential in this committed file. Inject
# registry auth at runtime via the NPM_TOKEN / NODE_AUTH_TOKEN environment
# variable instead, so secrets never enter version control.
